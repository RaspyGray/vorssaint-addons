+    }
+
+    private func pill(_ target: NotchDropTarget, symbol: String, title: String) -> some View {
+        let selected = targeted == target
+        return HStack(spacing: 5) {
+            Image(systemName: symbol).font(.system(size: 11, weight: .medium))
+                .dropArrivalBounce(selected: selected, enabled: animated)
+            Text(title).font(.system(size: 11, weight: .medium)).lineLimit(1)
+        }
+        .padding(.horizontal, 10).padding(.vertical, 5)
+        .background(Color.primary.opacity(selected ? 0.22 : 0.08), in: Capsule())
+        .overlay { Capsule().strokeBorder(Color.primary.opacity(selected ? 0.7 : 0.18), lineWidth: selected ? 1.2 : 0.75) }
+        .scaleEffect(animated && selected ? 1.08 : 1)
+        .overlay {
+            SendDropArea(onTarget: { inside in
+                if inside { targeted = target } else if targeted == target { targeted = nil }
+            }, onDrop: { pasteboard in
+                targeted = nil
+                return Self.send(pasteboard, to: target)
+            })
+        }
+        .accessibilityElement(children: .combine)
+    }
+}
+
+extension ShelfSendBar {
+    static func send(_ pasteboard: NSPasteboard, to target: NotchDropTarget) -> Bool {
+        switch target {
+        case .airDrop: return NotchAirDropService.send(NotchAirDropService.items(in: pasteboard))
+        case .device(let id): return KDEConnectService.shared.send(KDEConnectService.items(in: pasteboard), to: id)
+        default: return false
+        }
+    }
+}
+
+/// A native drop target exactly the size of one send pill. Only this view
+/// registers for drags, and only while the pill exists, so the shelf and the
+/// island keep receiving every other drop as before.
+struct SendDropArea: NSViewRepresentable {
+    let onTarget: (Bool) -> Void
+    let onDrop: (NSPasteboard) -> Bool
+
+    func makeNSView(context: Context) -> DropView {
+        let view = DropView()
+        view.onTarget = onTarget
+        view.onDrop = onDrop
+        return view
+    }
+
+    func updateNSView(_ view: DropView, context: Context) {
+        view.onTarget = onTarget
+        view.onDrop = onDrop
+    }
+
+    final class DropView: NSView {
+        var onTarget: ((Bool) -> Void)?
+        var onDrop: ((NSPasteboard) -> Bool)?
+
+        override init(frame: NSRect) {
+            super.init(frame: frame)
+            registerForDraggedTypes([.fileURL, .URL])
+        }
+
+        @available(*, unavailable)
+        required init?(coder: NSCoder) { nil }
+
+        /// A shelf tile offers only a move inside the app; anything else is copied.
+        private func operation(_ sender: NSDraggingInfo) -> NSDragOperation {
+            sender.draggingSourceOperationMask.contains(.copy) ? .copy : .move
+        }
+
+        override func draggingEntered(_ sender: NSDraggingInfo) -> NSDragOperation {
+            onTarget?(true)
+            return operation(sender)
+        }
+
+        override func draggingUpdated(_ sender: NSDraggingInfo) -> NSDragOperation { operation(sender) }
+        override func draggingExited(_ sender: NSDraggingInfo?) { onTarget?(false) }
+
+        override func performDragOperation(_ sender: NSDraggingInfo) -> Bool {
+            onTarget?(false)
+            return onDrop?(sender.draggingPasteboard) == true
+        }
+    }
+}
