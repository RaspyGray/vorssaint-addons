+                            pill(.device(device.id), symbol: "iphone.radiowaves.left.and.right", title: device.name)
+                                .transition(.scale(scale: 0.8).combined(with: .opacity))
+                        }
+                    }
+                }
+                .padding(.vertical, 3)
+            }
+        }
+        .animation(animated ? tileSpring : nil, value: kde.devices)
