+/// AirDrop and KDE Connect together: the island's send targets.
+enum NotchSendSupport {
+    static var anyActive: Bool { KDEConnectService.isActive || NotchAirDropService.isActive }
+
+    /// The island shows its drop area during a file drag for the send
+    /// targets alone, even with the shelf in its own window or switched off.
+    static func revealsDrag(in defaults: UserDefaults = .standard) -> Bool {
+        anyActive && NotchSupport.showsFiles(in: defaults) && defaults.bool(forKey: DefaultsKey.notchDragReveal)
+    }
+}
+
+/// A shelf tile is being dragged out, from the island or from the shelf's
+/// own window: both show their small send targets for its length.
+final class ShelfSendState: ObservableObject {
+    static let shared = ShelfSendState()
+    @Published private(set) var draggingOut = false
+    private init() {}
+
+    func begin() {
+        guard UserDefaults.standard.bool(forKey: DefaultsKey.notchShelfSendTargets), NotchSendSupport.anyActive else { return }
+        if KDEConnectService.isActive { KDEConnectService.shared.refresh() }
+        draggingOut = true
+    }
+
+    func end() { if draggingOut { draggingOut = false } }
+}
