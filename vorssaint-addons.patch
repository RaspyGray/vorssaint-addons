+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 Vorssaint
+
+import CoreGraphics
+
+struct KDEConnectDevice: Identifiable, Equatable {
+    let id: String
+    let name: String
+}
+
+/// Where a file dragged over the open island lands.
+enum NotchDropTarget: Hashable {
+    case shelf, media, airDrop, device(String)
+}
+
+/// The island's drop chooser: up to four equal columns side by side (shelf,
+/// media optimisation, AirDrop, KDE Connect), the KDE column split into one row per
+/// reachable device. The view draws the same split, so hit-testing here
+/// matches what is on screen.
+enum NotchDropLayout {
+    static func target(at point: CGPoint, in geometry: NotchGeometry, size: CGSize,
+                       shelf: Bool, media: Bool, airDrop: Bool = false,
+                       devices: [KDEConnectDevice]?) -> NotchDropTarget? {
+        let spacing = NotchFileToolsSupport.dropSpacing
+        let content = geometry.contentSize(for: size)
+        let area = CGRect(x: (size.width - content.width) / 2,
+                          y: geometry.headerTopInset + geometry.headerRowHeight + NotchLayout.spacing,
+                          width: content.width, height: content.height)
+        var columns: [NotchDropTarget?] = []
+        if shelf { columns.append(.shelf) }
+        if media { columns.append(.media) }
+        if airDrop { columns.append(.airDrop) }
+        if devices != nil { columns.append(nil) }
+        guard !columns.isEmpty, area.contains(point) else { return nil }
+        let width = (area.width - spacing * CGFloat(columns.count - 1)) / CGFloat(columns.count)
+        let index = min(columns.count - 1, Int((point.x - area.minX) / (width + spacing)))
+        if let column = columns[index] { return column }
+        guard let devices, !devices.isEmpty else { return nil }
+        let height = (area.height - spacing * CGFloat(devices.count - 1)) / CGFloat(devices.count)
+        let row = min(devices.count - 1, max(0, Int((point.y - area.minY) / (height + spacing))))
+        return .device(devices[row].id)
+    }
+}
