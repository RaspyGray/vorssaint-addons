diff --git a/Sources/Vorssaint/Services/Notch/KDEConnectService.swift b/Sources/Vorssaint/Services/Notch/KDEConnectService.swift
new file mode 100644
index 00000000..271a8b2d
--- /dev/null
+++ b/Sources/Vorssaint/Services/Notch/KDEConnectService.swift
@@ -0,0 +1,177 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 Vorssaint
+
+import AppKit
+import Combine
+
+/// Sends files to phones and computers paired in KDE Connect, through the
+/// command line tool bundled inside KDE Connect.app. Nothing runs at rest:
+/// devices are listed when a drag reaches the island or the page opens.
+final class KDEConnectService: ObservableObject {
+    static let shared = KDEConnectService()
+
+    enum SendState: Equatable {
+        case sending(device: String)
+        case sent(device: String)
+        case failed(device: String)
+    }
+
+    /// KDE Connect's own app hosts the daemon its tool talks to, so the tool
+    /// only answers while that app runs.
+    enum AppState: Equatable { case notInstalled, closed, launching, ready }
+
+    @Published private(set) var devices: [KDEConnectDevice] = []
+    @Published private(set) var isRefreshing = false
+    @Published private(set) var appState: AppState = KDEConnectService.isInstalled ? .ready : .notInstalled
+    @Published private(set) var sendState: SendState?
+    private let queue = DispatchQueue(label: "com.vorssaint.kdeconnect", qos: .userInitiated)
+    private var clearWork: DispatchWorkItem?
+    private var launchRetries = 0
+    static let bundleID = "org.kde.kdeconnect"
+    static let downloadURL = URL(string: "https://kdeconnect.kde.org/download.html")!
+
+    private init() {}
+
+    static var appURL: URL? {
+        var apps: [URL] = []
+        if let url = NSWorkspace.shared.urlForApplication(withBundleIdentifier: bundleID) { apps.append(url) }
+        apps.append(URL(fileURLWithPath: "/Applications/KDE Connect.app"))
+        apps.append(FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent("Applications/KDE Connect.app"))
+        return apps.first { FileManager.default.isExecutableFile(atPath: cli(in: $0).path) }
+    }
+
+    private static func cli(in app: URL) -> URL { app.appendingPathComponent("Contents/MacOS/kdeconnect-cli") }
+    static var cliURL: URL? { appURL.map(cli(in:)) }
+    static var isInstalled: Bool { appURL != nil }
+    static var isRunning: Bool { !NSRunningApplication.runningApplications(withBundleIdentifier: bundleID).isEmpty }
+
+    /// The island offers a KDE Connect column: the feature is installed and
+    /// on. A missing or closed KDE Connect shows in the column itself.
+    static var isActive: Bool {
+        AppFeature.notchKDEConnect.isAvailable
+            && UserDefaults.standard.bool(forKey: DefaultsKey.notchKDEConnectEnabled)
+    }
+
+    /// Installing the feature without KDE Connect on this Mac says so at once,
+    /// with the way to get it.
+    static func warnIfMissing() {
+        guard !isInstalled else { return }
+        DispatchQueue.main.async {
+            let text = FeatureStrings.kdeConnect(L10n.shared.language)
+            let alert = NSAlert()
+            alert.messageText = text.notInstalled
+            alert.informativeText = text.notInstalledDetail
+            alert.addButton(withTitle: text.download)
+            alert.addButton(withTitle: text.later)
+            NSApp.activate(ignoringOtherApps: true)
+            if alert.runModal() == .alertFirstButtonReturn { NSWorkspace.shared.open(downloadURL) }
+        }
+    }
+
+    /// Files, or web links, that KDE Connect can share.
+    static func items(in pasteboard: NSPasteboard) -> [URL] {
+        let urls = pasteboard.readObjects(forClasses: [NSURL.self], options: nil) as? [URL] ?? []
+        return urls.filter { $0.isFileURL || $0.scheme == "http" || $0.scheme == "https" }
+    }
+
+    /// Lists reachable devices. A closed KDE Connect is started hidden first,
+    /// and asked again while it finds its devices.
+    func refresh() {
+        guard let app = Self.appURL else { setAppState(.notInstalled); if !devices.isEmpty { devices = [] }; return }
+        guard Self.isRunning else {
+            if UserDefaults.standard.bool(forKey: DefaultsKey.notchKDEConnectAutoLaunch) { launch(app) }
+            else { setAppState(.closed); if !devices.isEmpty { devices = [] } }
+            return
+        }
+        if appState != .launching || !devices.isEmpty { setAppState(.ready) }
+        guard !isRefreshing else { return }
+        let cli = Self.cli(in: app)
+        isRefreshing = true
+        queue.async { [weak self] in
+            let output = Self.run(cli, ["--list-available", "--id-name-only"]).output
+            let found = output.split(separator: "\n").compactMap { line -> KDEConnectDevice? in
+                let parts = line.split(separator: " ", maxSplits: 1)
+                guard parts.count == 2 else { return nil }
+                return KDEConnectDevice(id: String(parts[0]), name: String(parts[1]))
+            }
+            DispatchQueue.main.async {
+                guard let self else { return }
+                self.isRefreshing = false
+                if self.devices != found { self.devices = found }
+                if self.appState == .launching {
+                    if !found.isEmpty || self.launchRetries >= 8 { self.setAppState(.ready); self.launchRetries = 0 }
+                    else { self.retryAfterLaunch() }
+                }
+            }
+        }
+    }
+
+    private func launch(_ app: URL) {
+        guard appState != .launching else { return }
+        setAppState(.launching)
+        if !devices.isEmpty { devices = [] }
+        launchRetries = 0
+        let configuration = NSWorkspace.OpenConfiguration()
+        configuration.activates = false
+        configuration.hides = true
+        configuration.addsToRecentItems = false
+        NSWorkspace.shared.openApplication(at: app, configuration: configuration) { [weak self] running, _ in
+            DispatchQueue.main.async {
+                guard let self else { return }
+                if running == nil { self.setAppState(.closed) } else { self.retryAfterLaunch() }
+            }
+        }
+    }
+
+    /// The daemon needs a moment after launch before it answers and finds devices.
+    private func retryAfterLaunch() {
+        launchRetries += 1
+        DispatchQueue.main.asyncAfter(deadline: .now() + 1) { [weak self] in
+            guard let self, self.appState == .launching else { return }
+            self.refresh()
+        }
+    }
+
+    private func setAppState(_ state: AppState) {
+        if appState != state { appState = state }
+    }
+
+    @discardableResult
+    func send(_ urls: [URL], to deviceID: String) -> Bool {
+        guard let cli = Self.cliURL, !urls.isEmpty,
+              let device = devices.first(where: { $0.id == deviceID }) else { return false }
+        setState(.sending(device: device.name))
+        queue.async { [weak self] in
+            let ok = urls.allSatisfy { url in
+                Self.run(cli, ["--device", deviceID, "--share", url.isFileURL ? url.path : url.absoluteString]).status == 0
+            }
+            DispatchQueue.main.async {
+                self?.setState(ok ? .sent(device: device.name) : .failed(device: device.name))
+                if !ok { self?.refresh() }
+            }
+        }
+        return true
+    }
+
+    private func setState(_ state: SendState) {
+        clearWork?.cancel(); clearWork = nil
+        sendState = state
+        if case .sending = state { return }
+        let work = DispatchWorkItem { [weak self] in self?.sendState = nil }
+        clearWork = work
+        DispatchQueue.main.asyncAfter(deadline: .now() + 3, execute: work)
+    }
+
+    private static func run(_ executable: URL, _ arguments: [String]) -> (status: Int32, output: String) {
+        let process = Process()
+        process.executableURL = executable
+        process.arguments = arguments
+        let pipe = Pipe()
+        process.standardOutput = pipe
+        process.standardError = FileHandle.nullDevice
+        do { try process.run() } catch { return (-1, "") }
+        let data = pipe.fileHandleForReading.readDataToEndOfFile()
+        process.waitUntilExit()
+        return (process.terminationStatus, String(decoding: data, as: UTF8.self))
+    }
+}
diff --git a/Sources/Vorssaint/Services/Notch/NotchAirDropService.swift b/Sources/Vorssaint/Services/Notch/NotchAirDropService.swift
new file mode 100644
index 00000000..7e1dd311
--- /dev/null
+++ b/Sources/Vorssaint/Services/Notch/NotchAirDropService.swift
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 Vorssaint
+
+import AppKit
+
+/// Hands dropped files to the system's AirDrop window. macOS offers no public
+/// way to list nearby devices, so the window itself lets the user pick one.
+enum NotchAirDropService {
+    static var isActive: Bool {
+        AppFeature.notchAirDrop.isAvailable
+            && UserDefaults.standard.bool(forKey: DefaultsKey.notchAirDropEnabled)
+    }
+
+    /// Files, or web links, that AirDrop can send.
+    static func items(in pasteboard: NSPasteboard) -> [URL] {
+        let urls = pasteboard.readObjects(forClasses: [NSURL.self], options: nil) as? [URL] ?? []
+        return urls.filter { $0.isFileURL || $0.scheme == "http" || $0.scheme == "https" }
+    }
+
+    @discardableResult
+    static func send(_ urls: [URL]) -> Bool {
+        guard !urls.isEmpty, let service = NSSharingService(named: .sendViaAirDrop),
+              service.canPerform(withItems: urls) else { return false }
+        // After the drag session ends, so the AirDrop window comes up in front.
+        DispatchQueue.main.async {
+            NSApp.activate(ignoringOtherApps: true)
+            service.perform(withItems: urls)
+        }
+        return true
+    }
+}
