+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 Vorssaint
+
+import AppKit
+import SwiftUI
+
+extension KDEConnectService.AppState {
+    /// What the island says instead of the device list, if anything.
+    func message(_ text: KDEConnectStrings) -> String? {
+        switch self {
+        case .notInstalled: return text.notInstalled
+        case .closed: return text.closed
+        case .launching: return text.launching
+        case .ready: return nil
+        }
+    }
+}
+
+private let tileSpring = Animation.spring(response: 0.32, dampingFraction: 0.78)
+
+/// Bounces a drop target's icon once as a file arrives on it, and only then:
+/// the tile the file just left stays still.
+struct DropArrivalBounce: ViewModifier {
+    let selected: Bool
+    let enabled: Bool
+    @State private var arrivals = 0
+
+    func body(content: Content) -> some View {
+        content
+            .symbolEffect(.bounce, value: arrivals)
+            .onChange(of: selected) { _, now in if now && enabled { arrivals += 1 } }
+    }
+}
+
+extension View {
+    func dropArrivalBounce(selected: Bool, enabled: Bool) -> some View {
+        modifier(DropArrivalBounce(selected: selected, enabled: enabled))
+    }
+}
+
+/// One drop tile per reachable device, stacked to fill the column the
+/// island's drop layout reserves for KDE Connect.
+struct KDEConnectDropColumn: View {
+    let target: NotchDropTarget?
+    @ObservedObject private var kde = KDEConnectService.shared
+    @ObservedObject private var l10n = L10n.shared
+    @AppStorage(DefaultsKey.notchDropAnimateSend) private var animated = true
+    private var text: KDEConnectStrings { FeatureStrings.kdeConnect(l10n.language) }
+
+    var body: some View {
+        VStack(spacing: NotchFileToolsSupport.dropSpacing) {
+            if kde.devices.isEmpty {
+                let busy = kde.isRefreshing || kde.appState == .launching
+                NotchDropTile(symbol: busy ? "antenna.radiowaves.left.and.right" : "iphone.slash",
+                               title: kde.appState.message(text) ?? (busy ? text.title : text.noDevices),
+                               selected: false, compact: false, animated: animated)
+                    .opacity(0.55)
+                    .symbolEffect(.variableColor.iterative, isActive: busy && animated)
+            } else {
+                ForEach(kde.devices) { device in
+                    NotchDropTile(symbol: "iphone.radiowaves.left.and.right", title: device.name,
+                                   selected: target == .device(device.id), compact: kde.devices.count > 2,
+                                   animated: animated)
+                        .transition(.scale(scale: 0.9).combined(with: .opacity))
+                }
+            }
+        }
+        .frame(maxWidth: .infinity, maxHeight: .infinity)
+        .animation(animated ? tileSpring : nil, value: kde.devices)
+        .animation(animated ? tileSpring : nil, value: target)
+    }
+}
+
+struct NotchDropTile: View {
+    let symbol: String
+    let title: String
+    let selected: Bool
+    let compact: Bool
+    var animated = true
+
+    var body: some View {
+        Group {
+            if compact {
+                HStack(spacing: 10) {
+                    Image(systemName: symbol).font(.system(size: 18, weight: .light))
+                    Text(title).font(.callout.weight(.medium)).lineLimit(1)
+                }
+            } else {
+                VStack(spacing: 10) {
+                    Image(systemName: symbol).font(.system(size: 28, weight: .light))
+                        .dropArrivalBounce(selected: selected, enabled: animated)
+                    Text(title).font(.callout.weight(.medium)).multilineTextAlignment(.center).lineLimit(2)
+                }
+            }
+        }
+        .padding(12)
+        .frame(maxWidth: .infinity, maxHeight: .infinity)
+        .background(.white.opacity(selected ? 0.14 : 0.04), in: RoundedRectangle(cornerRadius: 20))
+        .overlay {
+            RoundedRectangle(cornerRadius: 20)
+                .strokeBorder(.white.opacity(selected ? 0.7 : 0.2), lineWidth: selected ? 1.5 : 0.75)
+        }
+        .scaleEffect(animated && selected ? 1.03 : 1)
+        .accessibilityElement(children: .combine)
+        .accessibilityAddTraits(selected ? .isSelected : [])
+    }
+}
+
+/// The Files page when only KDE Connect lives there: the devices a drop
