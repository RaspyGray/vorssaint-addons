+struct KDEConnectStatus: View {
+    @ObservedObject private var kde = KDEConnectService.shared
+    @ObservedObject private var l10n = L10n.shared
+    private var text: KDEConnectStrings { FeatureStrings.kdeConnect(l10n.language) }
+
+    var body: some View {
