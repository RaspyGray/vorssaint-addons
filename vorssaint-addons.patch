+}
+
+/// Small drop targets along the bottom of the shelf while one of its tiles
+/// is dragged out: AirDrop and each reachable KDE Connect device. They
+/// replace the hint row for the length of the drag, nothing more.
+struct ShelfSendBar: View {
+    @ObservedObject private var kde = KDEConnectService.shared
+    @ObservedObject private var l10n = L10n.shared
+    @AppStorage(DefaultsKey.notchDropAnimateSend) private var animated = true
