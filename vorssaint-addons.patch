diff --git a/Sources/Vorssaint/UI/Settings/NotchSendSettings.swift b/Sources/Vorssaint/UI/Settings/NotchSendSettings.swift
new file mode 100644
index 00000000..82acd641
--- /dev/null
+++ b/Sources/Vorssaint/UI/Settings/NotchSendSettings.swift
@@ -0,0 +1,144 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 Vorssaint
+
+import SwiftUI
+
+/// Options for the island's drop targets, under the Files section.
+struct NotchSendSettingsControls: View {
+    @ObservedObject private var l10n = L10n.shared
+    @ObservedObject private var features = FeatureRuntime.shared
+    @AppStorage(DefaultsKey.notchDropAnimateShelf) private var animateShelf = true
+    @AppStorage(DefaultsKey.notchDropAnimateSend) private var animateSend = true
+    @AppStorage(DefaultsKey.notchShelfSendTargets) private var shelfSend = true
+    @AppStorage(DefaultsKey.notchKDEConnectAutoLaunch) private var autoLaunch = true
+    private var text: NotchSendStrings { FeatureStrings.notchSend(l10n.language) }
+
+    var body: some View {
+        let _ = features.revision
+        let kde = AppFeature.notchKDEConnect.isAvailable
+        let sends = kde || AppFeature.notchAirDrop.isAvailable
+        Divider()
+        VStack(alignment: .leading, spacing: 12) {
+            VStack(alignment: .leading, spacing: 2) {
+                Text(text.section).font(.headline)
+                Text(text.previewHint).font(.caption).foregroundStyle(.secondary)
+            }
+            row("tray.and.arrow.down", text.animateShelf, text.animateShelfHint, $animateShelf)
+            if sends {
+                row("sparkles", text.animateSend, text.animateSendHint, $animateSend)
+                if AppFeature.shelf.isAvailable {
+                    row("hand.point.up.left", text.shelfSend, text.shelfSendHint, $shelfSend)
+                }
+            }
+            if kde { row("iphone.radiowaves.left.and.right", text.autoLaunch, text.autoLaunchHint, $autoLaunch) }
+        }
+        .contentShape(Rectangle())
+        // The preview beside plays a file passing over the drop targets.
+        .onHover { NotchDropPreviewDemo.shared.hover($0) }
+        .onChange(of: [animateShelf, animateSend, shelfSend]) { NotchDropPreviewDemo.shared.hover(true) }
+        .onDisappear { NotchDropPreviewDemo.shared.active = false }
+    }
+
+    private func row(_ symbol: String, _ title: String, _ caption: String, _ isOn: Binding<Bool>) -> some View {
+        SettingsRow(symbol: symbol, title: title, caption: caption) {
+            Toggle(title, isOn: isOn).labelsHidden().toggleStyle(.switch)
+        }
+    }
+}
+
+/// Whether the settings preview plays the drop demo instead of the page.
+final class NotchDropPreviewDemo: ObservableObject {
+    static let shared = NotchDropPreviewDemo()
+    @Published var active = false
+    private var linger: DispatchWorkItem?
+    private init() {}
+
+    /// Keeps playing a moment after the pointer leaves the options, long
+    /// enough to look across at the preview.
+    func hover(_ inside: Bool) {
+        linger?.cancel(); linger = nil
+        if inside { if !active { active = true }; return }
+        let work = DispatchWorkItem { [weak self] in self?.active = false }
+        linger = work
+        DispatchQueue.main.asyncAfter(deadline: .now() + 4, execute: work)
+    }
+}
+
+/// A file passing over each drop target in turn, with the motion the
+/// current settings give it: the island's drop chooser as it will look.
+struct NotchDropChooserDemo: View {
+    @ObservedObject private var kde = KDEConnectService.shared
+    @ObservedObject private var l10n = L10n.shared
+    @AppStorage(DefaultsKey.notchDropAnimateShelf) private var animateShelf = true
+    @AppStorage(DefaultsKey.notchDropAnimateSend) private var animateSend = true
+    @State private var step = 0
+    @Namespace private var file
+    private let timer = Timer.publish(every: 1.1, on: .main, in: .common).autoconnect()
+
+    private var devices: [KDEConnectDevice] {
+        kde.devices.isEmpty ? [KDEConnectDevice(id: "demo", name: FeatureStrings.notchSend(l10n.language).phone)] : kde.devices
+    }
+
+    private var shelf: Bool {
+        AppFeature.shelf.isAvailable && UserDefaults.standard.bool(forKey: DefaultsKey.shelfEnabled)
+    }
+
+    private var targets: [NotchDropTarget] {
+        var all: [NotchDropTarget] = []
+        if shelf { all.append(.shelf) }
+        if NotchAirDropService.isActive { all.append(.airDrop) }
+        if KDEConnectService.isActive { all += devices.map { .device($0.id) } }
+        return all
+    }
+
+    private var target: NotchDropTarget? {
+        let all = targets
+        return all.isEmpty ? nil : all[step % all.count]
+    }
+
+    var body: some View {
+        HStack(spacing: NotchFileToolsSupport.dropSpacing) {
+            if shelf {
+                tile(.shelf, symbol: "tray.and.arrow.down", title: FeatureStrings.notch(l10n.language).files,
+                     animated: animateShelf)
+            }
+            if NotchAirDropService.isActive {
+                tile(.airDrop, symbol: "dot.radiowaves.left.and.right",
+                     title: FeatureStrings.notchAirDrop(l10n.language).tile, animated: animateSend)
+            }
+            if KDEConnectService.isActive {
+                VStack(spacing: NotchFileToolsSupport.dropSpacing) {
+                    ForEach(devices) { device in
+                        tile(.device(device.id), symbol: "iphone.radiowaves.left.and.right", title: device.name,
+                             animated: animateSend, compact: devices.count > 2)
+                    }
+                }
+            }
+        }
+        .frame(maxWidth: .infinity, maxHeight: .infinity)
+        .onReceive(timer) { _ in
+            let next = targets.count > 0 ? (step + 1) % targets.count : 0
+            let lands = targets.isEmpty ? nil : targets[next]
+            let animated = lands == .shelf ? animateShelf : animateSend
+            withAnimation(animated ? .spring(response: 0.32, dampingFraction: 0.78) : .easeInOut(duration: 0.2)) {
+                step = next
+            }
+        }
+    }
+
+    private func tile(_ id: NotchDropTarget, symbol: String, title: String, animated: Bool,
+                      compact: Bool = false) -> some View {
+        let selected = target == id
+        return NotchDropTile(symbol: symbol, title: title, selected: selected, compact: compact, animated: animated)
+            .overlay(alignment: .bottomTrailing) {
+                if selected {
+                    Image(systemName: "doc.fill")
+                        .font(.system(size: 16))
+                        .foregroundStyle(.white.opacity(0.9))
+                        .shadow(radius: 3)
+                        .padding(10)
+                        .matchedGeometryEffect(id: "file", in: file)
+                }
+            }
+    }
+}
